@model IEnumerable<IT_ELECTIVE_2_PREFINAL_EXAM.Models.QuestionItem>

@{
    ViewData["Title"] = "Prefinals Exam Answers";
}

<div class="container my-4">
    <div class="p-4 mb-4 bg-dark text-white rounded-3 shadow">
        <h1 class="display-5 fw-bold">IT ELECTIVE 2 – PREFINALS EXAMINATION</h1>
        <p class="fs-5 text-info">Web Systems and Technologies | 1st Semester, AY 2026-2027</p>
    </div>

    <div class="row">
        @foreach (var item in Model)
        {
            <div class="col-12 mb-4">
                <div class="card shadow-sm border-0 h-100">
                    <div class="card-header bg-primary text-white d-flex justify-content-between align-items-center">
                        <span class="fw-bold">Question #@item.Id</span>
                        <span class="badge bg-light text-primary fs-6">Multiple Choice</span>
                    </div>
                    <div class="card-body">
                        <h5 class="card-title text-dark mb-3">@item.Question</h5>
                        <ul class="list-group list-group-flush mb-3">
                            @foreach (var option in item.Options)
                            {
                                bool isCorrect = option == item.CorrectAnswer;
                                <li class="list-group-item @(isCorrect ? "list-group-item-success fw-bold" : "")">
                                    @option
                                    @if (isCorrect)
                                    {
                                        <span class="badge bg-success float-end">Correct Answer</span>
                                    }
                                </li>
                            }
                        </ul>
                        <div class="alert alert-secondary mb-0" role="alert">
                            <i class="bi bi-info-circle-fill me-2"></i><strong>Explanation:</strong> @item.Explanation
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>